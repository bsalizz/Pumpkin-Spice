---
import antonWoff2 from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import Seo from '../components/seo/Seo.astro';
import type { Locale } from '../config/site.ts';
import type { Dictionary } from '../i18n/types.ts';
import '../styles/global.css';

interface Props {
  locale: Locale;
  dict: Dictionary;
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: boolean;
}

const { locale, dict, ...seo } = Astro.props;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo locale={locale} dict={dict} {...seo} />
  </head>
  <body>
    <a class="skip-link mono" href="#main">
      {dict.a11y.skip}
    </a>
    <slot />
  </body>
</html>
