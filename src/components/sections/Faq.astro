---
import type { Dictionary } from '../../i18n/types.ts';

interface Props {
  dict: Dictionary;
}

const { faq } = Astro.props.dict;
---

<section class="faq section" id="faq" data-scene="faq" aria-labelledby="faq-title">
  <header class="faq__head">
    <p class="label mono" data-reveal>
      {faq.label}
    </p>
    <h2 class="faq__title display" id="faq-title">
      <span class="split-line">
        <span data-split="chars" data-reveal-chars>
          {faq.title}
        </span>
      </span>
    </h2>
  </header>

  <div class="faq__list">
    {faq.items.map((item) => (
      <details class="faq__item" data-reveal>
        <summary class="faq__question">
          <span class="serif-italic">{item.question}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 3rem;
  }

  .faq__head {
    display: grid;
    gap: 1.5rem;
  }

  .faq__title {
    font-size: clamp(3rem, 1.2rem + 7vw, 8.5rem);
  }

  .faq__list {
    border-top: 1px solid var(--c-cream-faint);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-cream-faint);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.6rem 0;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem);
    line-height: 1.1;
    list-style: none;
    cursor: pointer;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--c-gold);
    transition: transform 0.5s var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__answer {
    max-width: 52ch;
    padding-bottom: 1.8rem;
    color: var(--c-cream-dim);
  }

  .faq__answer p {
    font-size: var(--fs-body);
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
</style>
