---
import type { Locale } from '../config/site.ts';
import { getDictionary } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardInvite from './sections/CardInvite.astro';
import Elixir from './sections/Elixir.astro';
import Faq from './sections/Faq.astro';
import Footer from './sections/Footer.astro';
import Hero from './sections/Hero.astro';
import Manifesto from './sections/Manifesto.astro';
import Reserve from './sections/Reserve.astro';
import Ritual from './sections/Ritual.astro';
import Stats from './sections/Stats.astro';
import Story from './sections/Story.astro';
import Header from './ui/Header.astro';
import Marquee from './ui/Marquee.astro';
import Overlays from './ui/Overlays.astro';
import Preloader from './ui/Preloader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
---

<BaseLayout locale={locale} dict={dict} structuredData>
  <div class="scene" aria-hidden="true">
    <div class="scene__fallback"></div>
    <canvas class="scene__canvas" data-webgl></canvas>
  </div>
  <p class="visually-hidden">{dict.a11y.flacon3d}</p>

  <Preloader label={dict.preloader} />
  <Header locale={locale} dict={dict} />

  <main id="main">
    <Hero dict={dict} />
    <Manifesto dict={dict} />
    <Story dict={dict} />
    <Elixir dict={dict} />
    <Marquee items={dict.marquee} />
    <Stats dict={dict} locale={locale} />
    <Ritual dict={dict} />
    <Reserve dict={dict} locale={locale} />
    <Faq dict={dict} />
    <CardInvite dict={dict} locale={locale} />
  </main>

  <Footer dict={dict} locale={locale} />
  <Overlays />
</BaseLayout>

<script>
  import { boot } from '../scripts/main.ts';

  boot();
</script>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: var(--z-canvas);
    pointer-events: none;
  }

  .scene__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 42%, rgb(234 122 44 / 0.28), transparent 70%),
      radial-gradient(80% 60% at 20% 90%, rgb(194 64 31 / 0.22), transparent 70%), var(--c-ink);
  }

  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }

  .scene__canvas.is-ready {
    opacity: 1;
  }
</style>
