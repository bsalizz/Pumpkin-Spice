---
import { OG_LOCALE, SITE, type Locale } from '../../config/site.ts';
import type { Dictionary } from '../../i18n/types.ts';
import { buildJsonLd, buildPageJsonLd, serializeJsonLd } from '../../lib/seo/jsonld.ts';
import { absoluteUrl, alternates, localeUrl } from '../../lib/seo/urls.ts';

interface Props {
  locale: Locale;
  dict: Dictionary;
  /** Overrides for non-home pages. */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Page path relative to the locale root (`card/`); empty for the home page. */
  page?: string;
  /** Social image, relative to the site root, without the locale suffix (`og/og-card`). */
  ogImage?: string;
  ogImageAlt?: string;
  /** Emit the structured-data graph: the full home graph or a sub-page graph. */
  structuredData?: boolean;
}

const {
  locale,
  dict,
  title = dict.meta.title,
  description = dict.meta.description,
  noindex = false,
  page = '',
  ogImage: ogImageBase = 'og/og',
  ogImageAlt = dict.meta.ogImageAlt,
  structuredData = false,
} = Astro.props;

const canonical = localeUrl(locale, page);
const ogImage = absoluteUrl(`${ogImageBase}-${locale}.jpg`);
const otherLocales = Object.entries(OG_LOCALE).filter(([key]) => key !== locale);
const graph =
  page === ''
    ? buildJsonLd({ locale, dict, ogImage })
    : buildPageJsonLd({ locale, page, name: title, description, ogImage, home: SITE.brand });
const jsonLd = structuredData ? serializeJsonLd(graph) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={
    noindex
      ? 'noindex, follow'
      : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  }
/>
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex &&
  alternates(page).map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link rel="sitemap" type="application/xml" href={absoluteUrl('sitemap-index.xml')} />

<meta name="author" content={SITE.brand} />
<meta name="application-name" content={SITE.product} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />

<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
<link
  rel="icon"
  href={`${import.meta.env.BASE_URL}icons/favicon-32.png`}
  sizes="32x32"
  type="image/png"
/>
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`} />
<!-- Same-origin, base-relative: the manifest is fetched with CORS. -->
<link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest`} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{otherLocales.map(([, og]) => (
  <meta property="og:locale:alternate" content={og} />
))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
