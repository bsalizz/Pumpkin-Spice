---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<figure class:list={['frame', className]} data-unveil>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[640, 1024, 1440, 1888]}
    sizes="100vw"
    quality={74}
    loading="lazy"
    decoding="async"
    class="frame__image"
  />
</figure>

<style>
  .frame {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--c-cream-faint);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 80% at 50% 50%, transparent 55%, rgb(11 7 5 / 0.7));
    pointer-events: none;
  }

  .frame :global(.frame__image) {
    display: block;
    width: 100%;
    height: 118%;
    object-fit: cover;
    will-change: transform;
  }

  @media (min-width: 600px) {
    .frame {
      aspect-ratio: 21 / 9;
    }
  }
</style>
