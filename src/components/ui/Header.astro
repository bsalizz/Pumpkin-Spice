---
import { LOCALE_PATH, LOCALES, SITE, type Locale } from '../../config/site.ts';
import type { Dictionary } from '../../i18n/types.ts';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  { href: '#story', label: dict.nav.story },
  { href: '#elixir', label: dict.nav.elixir },
  { href: '#ritual', label: dict.nav.ritual },
  { href: '#reserve', label: dict.nav.reserve },
  { href: `${base}${LOCALE_PATH[locale]}card/`, label: dict.nav.card },
] as const;
---

<header class="header" data-header>
  <a class="header__brand mono" href={`${base}${LOCALE_PATH[locale]}`}>
    {SITE.brand}
  </a>

  <nav class="header__nav" aria-label={dict.a11y.menu}>
    <ul>
      {links.map((link) => (
        <li>
          <a class="mono header__link" href={link.href} data-magnetic>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="header__tools">
    <ul class="header__langs" aria-label={dict.a11y.language}>
      {LOCALES.map((code) => (
        <li>
          <a
            class="mono header__lang"
            href={`${base}${LOCALE_PATH[code]}`}
            hreflang={code}
            lang={code}
            aria-current={code === locale ? 'true' : undefined}
          >
            {code}
          </a>
        </li>
      ))}
    </ul>
    <button
      class="header__sound mono"
      type="button"
      data-sound
      aria-pressed="false"
      aria-label={dict.a11y.soundOn}
      data-label-on={dict.a11y.soundOn}
      data-label-off={dict.a11y.soundOff}
    >
      <span class="header__bars" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-chrome);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: max(0.9rem, env(safe-area-inset-top)) var(--gutter) 0.9rem;
    color: var(--c-cream);
    background: linear-gradient(to bottom, rgb(11 7 5 / 0.55), transparent);
  }

  .header__brand {
    letter-spacing: 0.42em;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul,
  .header__langs {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.6rem);
  }

  .header__link,
  .header__lang {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
  }

  .header__link::after,
  .header__lang::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
  }

  .header__link:hover::after,
  .header__lang:hover::after,
  .header__lang[aria-current='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__lang {
    min-width: 1.5rem;
    text-align: center;
    padding: 0.6rem 0.1rem;
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .header__sound {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
  }

  .header__bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }

  .header__bars i {
    width: 2px;
    height: 3px;
    background: currentColor;
    transition: height 0.4s var(--ease-out);
  }

  .header__sound[aria-pressed='true'] .header__bars i {
    animation: bars 1.1s var(--ease-in-out) infinite alternate;
  }

  .header__sound[aria-pressed='true'] .header__bars i:nth-child(2) {
    animation-delay: -0.4s;
  }

  .header__sound[aria-pressed='true'] .header__bars i:nth-child(3) {
    animation-delay: -0.8s;
  }

  .header__sound[aria-pressed='true'] .header__bars i:nth-child(4) {
    animation-delay: -0.2s;
  }

  @keyframes bars {
    from {
      height: 3px;
    }

    to {
      height: 14px;
    }
  }

  @media (min-width: 900px) {
    .header__nav {
      display: block;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>
