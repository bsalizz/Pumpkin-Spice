---
/** Minimal stroke illustrations used as motion-graphics accents. */
export type LineArtName = 'leaves' | 'flame' | 'frost' | 'cups' | 'pan' | 'drop';

interface Props {
  name: LineArtName;
  class?: string;
}

const { name, class: className } = Astro.props;

const PATHS: Record<LineArtName, readonly string[]> = {
  leaves: [
    'M28 70C20 52 26 34 44 26c4 18-2 34-16 44Z',
    'M28 70c6-14 10-26 16-44',
    'M72 70c8-18 2-36-16-44-4 18 2 34 16 44Z',
    'M72 70c-6-14-10-26-16-44',
    'M50 82c-6-8-14-10-22-12M50 82c6-8 14-10 22-12M50 82v8',
  ],
  flame: [
    'M50 88c-16 0-24-10-24-22 0-16 14-22 16-40 10 8 12 16 10 24 6-4 8-10 8-16 10 10 14 20 14 32 0 12-8 22-24 22Z',
    'M50 88c-7 0-11-5-11-11 0-8 7-11 9-19 6 6 13 11 13 19 0 6-4 11-11 11Z',
  ],
  frost: [
    'M50 14v72M19 32l62 36M19 68l62-36',
    'M50 24l-7-7M50 24l7-7M50 76l-7 7M50 76l7 7',
    'M27 37l-10-2M27 37l-3 10M73 63l10 2M73 63l3-10',
    'M27 63l-10 2M27 63l-3-10M73 37l10-2M73 37l3 10',
  ],
  cups: [
    'M14 52h30v14c0 9-6 16-15 16s-15-7-15-16V52Z',
    'M44 57h4c4 0 6 3 6 6s-2 6-6 6h-4',
    'M56 52h30v14c0 9-6 16-15 16s-15-7-15-16V52Z',
    'M86 57h4c4 0 6 3 6 6s-2 6-6 6h-4',
    'M24 44c-4-5 4-8 0-14M32 44c-4-5 4-8 0-14',
  ],
  pan: [
    'M20 56h52v10c0 10-8 16-18 16H38c-10 0-18-6-18-16V56Z',
    'M72 60h20',
    'M36 46c-4-5 4-8 0-14M46 46c-4-5 4-8 0-14M56 46c-4-5 4-8 0-14',
  ],
  drop: ['M50 16C38 34 30 46 30 58a20 20 0 0 0 40 0c0-12-8-24-20-42Z', 'M40 60a10 10 0 0 0 10 10'],
};
---

<svg
  class:list={['line-art', className]}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-draw
>
  {PATHS[name].map((d) => (
    <path d={d} pathLength="1"></path>
  ))}
</svg>

<style>
  .line-art path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  :global(.js) .line-art path {
    stroke-dashoffset: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .line-art path {
      stroke-dashoffset: 0;
    }
  }
</style>
